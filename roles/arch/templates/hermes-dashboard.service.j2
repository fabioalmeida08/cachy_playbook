# Hermes Agent web dashboard - systemd unit rendered by Ansible.
#
# `{{ user }}` / `{{ home }}` come from local.yml (SUDO_USER), so the unit
# always targets the real desktop user, never root.
#
# The dashboard is bound to the machine's tailscale IPv4 so only the tailnet
# can reach it (the server's ufw already allows everything coming in on
# tailscale0 - no extra rule needed). `$(tailscale ip -4)` is resolved at every
# start: the node IP is stable per machine, but this way nothing is hardcoded
# and a changed IP is picked up on the next restart.
#
# A non-loopback bind engages the dashboard auth gate: without a configured
# user/password the process REFUSES to start (fail-closed). That is expected
# before the manual `hermes setup` / credential step - see README "Hermes
# dashboard (server)". Restart=always + RestartSec=10 make the service come up
# by itself as soon as the credential exists.
#
# RestartPreventExitStatus=78: exit 78 is a deliberate refusal ("this host is
# already served by PID ... on another port"); parking on it beats an infinite
# restart loop with nothing listening.
#
# StartLimit*: without it, a reboot done BEFORE the credential exists would
# retry forever and fill the journal. With it the unit stops in `failed` after
# 5 attempts in ~50s; the counter lives in RAM, so the next reboot (or
# `systemctl reset-failed` + start) begins clean.
#
# EnvironmentFile carries ~/.hermes/.env (API keys etc.) into the process;
# the `-` prefix only makes a missing file non-fatal (partial runs, install
# not done yet) - bad lines still fail loudly.

[Unit]
Description=Hermes Agent web dashboard
After=network-online.target tailscaled.service
Wants=tailscaled.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ user }}
WorkingDirectory={{ home }}
EnvironmentFile=-%h/.hermes/.env
ExecStart={{ home }}/.local/bin/hermes dashboard --host "$(tailscale ip -4)" --port 9119 --no-open
Restart=always
RestartSec=10
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
